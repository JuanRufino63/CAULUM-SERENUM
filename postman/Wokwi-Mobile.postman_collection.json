{
  "info": {
    "name": "AlertaCalor API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000"
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health"
      }
    },
    {
      "name": "Enviar leitura",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"temperature\": 36.2, \"humidity\": 78, \"alarm_muted\": false}"
        },
        "url": "{{baseUrl}}/readings"
      }
    },
    {
      "name": "\u00daltima leitura",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/readings/latest"
      }
    }
  ]
}